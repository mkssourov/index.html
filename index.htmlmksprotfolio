function loadReviews() {
  try { return JSON.parse(localStorage.getItem(REVIEWS_KEY)) || []; } catch(e) { return []; }
}
function saveReviews(reviews) { localStorage.setItem(REVIEWS_KEY, JSON.stringify(reviews)); }
function getInitials(name) { return name.trim().split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2)||'?'; }
function renderStars(rating, size=13) { return Array.from({length:5},(_,i)=>`<span style="font-size:${size}px">${i<rating?'⭐':'☆'}</span>`).join(''); }
function formatDate(iso) { const d=new Date(iso); return d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}); }

function updateSummary(reviews) {
  const total=reviews.length, avg=total?(reviews.reduce((s,r)=>s+r.rating,0)/total):0;
  document.getElementById('avgRatingNum').textContent=total?avg.toFixed(1):'0.0';
  document.getElementById('totalReviewsLabel').textContent=total?`${total} review${total>1?'s':''}`:'No reviews yet';
  document.getElementById('avgStarsDisplay').innerHTML=Array.from({length:5},(_,i)=>`<span class="star" style="font-size:1.4rem">${i<Math.round(avg)?'⭐':'☆'}</span>`).join('');
  [1,2,3,4,5].forEach(n=>{
    const cnt=reviews.filter(r=>r.rating===n).length, pct=total?(cnt/total*100):0;
    document.getElementById('bar'+n).style.width=pct+'%';
    document.getElementById('cnt'+n).textContent=cnt;
  });
}

const REVIEWS_PER_PAGE = 3;
let currentReviewPage = 1;

function renderReviewCards(reviews, page) {
  page = page || currentReviewPage;
  const list=document.getElementById('reviewsList'), noMsg=document.getElementById('noReviewsMsg');
  const paginEl = document.getElementById('reviewsPagination');
  if(!reviews.length){list.innerHTML='';list.appendChild(noMsg);paginEl.innerHTML='';return;}
  if(noMsg.parentNode)noMsg.remove();
  const sorted=[...reviews].reverse();
  const totalPages = Math.ceil(sorted.length / REVIEWS_PER_PAGE);
  const start = (page-1)*REVIEWS_PER_PAGE, end = start+REVIEWS_PER_PAGE;
  const pageItems = sorted.slice(start, end);
  list.innerHTML=pageItems.map(r=>`
    <div class="review-card">
      <div class="review-card-header">
        <div class="review-avatar" style="background:${r.avatarColor}">${r.initials}</div>
        <div class="review-meta"><div class="review-name">${r.name}</div><div class="review-date">${formatDate(r.date)}</div></div>
        <div class="review-stars">${renderStars(r.rating)}</div>
      </div>
      ${r.text?`<div class="review-text">"${r.text}"</div>`:''}
      ${r.country?`<div class="review-country">📍 ${r.country}</div>`:''}
    </div>
  `).join('');
  // Pagination buttons
  if(totalPages <= 1){paginEl.innerHTML='';return;}
  let btnHtml = `<button class="rev-page-btn" onclick="goReviewPage(${page-1})" ${page===1?'disabled':''}>← Prev</button>`;
  for(let i=1;i<=totalPages;i++){
    btnHtml += `<button class="rev-page-btn ${i===page?'active':''}" onclick="goReviewPage(${i})">${i}</button>`;
  }
  btnHtml += `<button class="rev-page-btn" onclick="goReviewPage(${page+1})" ${page===totalPages?'disabled':''}>Next →</button>`;
  paginEl.innerHTML = btnHtml;
}

function goReviewPage(page) {
  if(page < 1) return;
  const allReviews = loadReviews();
  const sorted = [...allReviews].reverse();
  const totalPages = Math.ceil(sorted.length / REVIEWS_PER_PAGE);
  if(page > totalPages) return;
  currentReviewPage = page;
  reviews = allReviews;
  renderReviewCards(reviews, page);
  const listEl = document.getElementById('reviewsList');
  if(listEl) listEl.scrollIntoView({behavior:'smooth', block:'nearest'});
}

