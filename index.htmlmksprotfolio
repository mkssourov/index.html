function handleBgImgUpload(input, idx, prefix) {
  const file = input.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    const base64 = e.target.result;
    document.getElementById(prefix+'-bgImg-'+idx).value = base64;
    const preview = document.getElementById(prefix+'-bg-preview-'+idx);
    if(preview) preview.style.backgroundImage = `linear-gradient(to bottom,rgba(6,6,16,0.3),rgba(6,6,16,0.75)),url(${base64})`;
  };
  reader.readAsDataURL(file);
}

function clearBgImg(idx, prefix) {
  document.getElementById(prefix+'-bgImg-'+idx).value = '';
  const bgVal = document.getElementById(prefix+'-bg-val-'+idx)?.value;
  const preview = document.getElementById(prefix+'-bg-preview-'+idx);
  if(preview) preview.style.backgroundImage = prefix==='svc' ? getBgCss(bgVal) : getPrjBgCss(bgVal);
  if(prefix==='svc') renderServicesAdmin(); else renderProjectsAdmin();
}

