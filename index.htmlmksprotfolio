function renderAdminReviews() {
  const el = document.getElementById('admin-reviews-list');
  const cntEl = document.getElementById('admin-review-count');
  if(!el) return;
  const sorted = [...reviews].reverse();
  cntEl.textContent = sorted.length;
  if(!sorted.length) {
    el.innerHTML = '<div class="admin-no-reviews">কোনো রিভিউ নেই এখনো।</div>';
    return;
  }
  // Map sorted index back to original index for delete/save
  el.innerHTML = sorted.map((r, si) => {
    const origIdx = reviews.length - 1 - si;
    const stars = [1,2,3,4,5].map(n =>
      `<span class="admin-sp-star ${n<=r.rating?'active':''}" onclick="setAdminReviewStar(${origIdx},${n})">${n<=r.rating?'⭐':'☆'}</span>`
    ).join('');
    return `
    <div class="admin-review-item" id="admin-rev-item-${origIdx}">
      <div class="admin-review-header">
        <div class="admin-review-meta">
          <div class="admin-review-avatar" style="background:${r.avatarColor}">${r.initials}</div>
          <div class="admin-review-info">
            <input class="admin-review-name-input" id="ar-name-${origIdx}" value="${r.name.replace(/"/g,'&quot;')}" placeholder="নাম">
            <div class="admin-review-date">${formatDate(r.date)}</div>
          </div>
        </div>
        <div class="admin-review-actions">
          <button class="admin-review-save-btn" onclick="saveReviewEdit(${origIdx})">💾 সেভ</button>
          <button class="admin-review-del-btn" onclick="deleteReview(${origIdx})">🗑 ডিলিট</button>
        </div>
      </div>
      <div class="admin-review-body">
        <textarea class="admin-review-text-input" id="ar-text-${origIdx}" placeholder="রিভিউ টেক্সট...">${r.text||''}</textarea>
        <div class="admin-review-row2">
          <input class="admin-review-country-input" id="ar-country-${origIdx}" value="${r.country||''}" placeholder="দেশ (optional)">
          <div class="admin-star-picker" id="ar-stars-${origIdx}">${stars}</div>
        </div>
      </div>
    </div>`;
  }).join('');
}

function setAdminReviewStar(origIdx, val) {
  reviews[origIdx].rating = val;
  // Update star UI only
  const picker = document.getElementById('ar-stars-'+origIdx);
  if(picker) picker.querySelectorAll('.admin-sp-star').forEach((s,i)=>{
    s.textContent = i<val ? '⭐' : '☆';
    s.classList.toggle('active', i<val);
  });
}

function saveReviewEdit(origIdx) {
  const nameEl = document.getElementById('ar-name-'+origIdx);
  const textEl = document.getElementById('ar-text-'+origIdx);
  const countryEl = document.getElementById('ar-country-'+origIdx);
  if(!nameEl) return;
  reviews[origIdx].name = nameEl.value.trim() || reviews[origIdx].name;
  reviews[origIdx].initials = getInitials(reviews[origIdx].name);
  reviews[origIdx].text = textEl ? textEl.value.trim() : reviews[origIdx].text;
  reviews[origIdx].country = countryEl ? countryEl.value.trim() : reviews[origIdx].country;
  saveReviews(reviews);
  updateSummary(reviews);
  renderReviewCards(reviews, currentReviewPage);
  renderAdminReviews();
  showAdminToast('রিভিউ আপডেট হয়েছে!');
}

function deleteReview(origIdx) {
  if(!confirm('এই রিভিউটি মুছে ফেলবেন?')) return;
  reviews.splice(origIdx, 1);
  saveReviews(reviews);
  updateSummary(reviews);
  currentReviewPage = 1;
  renderReviewCards(reviews, 1);
  renderAdminReviews();
  showAdminToast('রিভিউ ডিলিট হয়েছে!');
}

