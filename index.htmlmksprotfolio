function addReviewFromAdmin() {
  const name = document.getElementById('ar-new-name').value.trim();
  if(!name) { showAdminToast('নাম লিখুন!'); return; }
  const avatarColors=['linear-gradient(135deg,#7c5cfc,#c850c0)','linear-gradient(135deg,#00d4aa,#0a8a6e)','linear-gradient(135deg,#ff6b9d,#c850c0)','linear-gradient(135deg,#ffb347,#ff6b9d)','linear-gradient(135deg,#7c5cfc,#00d4aa)'];
  const newReview = {
    name: name,
    initials: getInitials(name),
    country: document.getElementById('ar-new-country').value.trim(),
    rating: newAdminReviewRating,
    text: document.getElementById('ar-new-text').value.trim(),
    date: new Date().toISOString(),
    avatarColor: avatarColors[Math.floor(Math.random()*avatarColors.length)]
  };
  reviews.push(newReview);
  saveReviews(reviews);
  updateSummary(reviews);
  renderReviewCards(reviews, 1);
  renderAdminReviews();
  // Reset form
  document.getElementById('ar-new-name').value = '';
  document.getElementById('ar-new-country').value = '';
  document.getElementById('ar-new-text').value = '';
  newAdminReviewRating = 5;
