<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MKS Sourov — Fullstack Engineer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #060610;
    --bg2: #0d0d1f;
    --bg3: #111128;
    --surface: rgba(255,255,255,0.04);
    --surface2: rgba(255,255,255,0.07);
    --border: rgba(255,255,255,0.08);
    --border2: rgba(255,255,255,0.14);
    --text: #f0eeff;
    --text2: #a09cb8;
    --text3: #5e5a78;
    --purple: #7c5cfc;
    --purple2: #9b80ff;
    --teal: #00d4aa;
    --teal2: #00ffcc;
    --pink: #ff6b9d;
    --amber: #ffb347;
    --grad: linear-gradient(135deg, #7c5cfc, #00d4aa);
    --grad2: linear-gradient(135deg, #7c5cfc 0%, #c850c0 50%, #00d4aa 100%);
    --font-display: 'Syne', sans-serif;
    --font-body: 'DM Sans', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    overflow-x: hidden;
    cursor: none;
  }

  /* ══════════════════════════════════════
     INTRO ANIMATION SCREEN
  ══════════════════════════════════════ */
  #intro-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: #020208;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    overflow: hidden;
  }

  #intro-screen.done {
    pointer-events: none;
    animation: intro-exit 0.8s cubic-bezier(0.76,0,0.24,1) 0.1s forwards;
  }

  @keyframes intro-exit {
    0% { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); opacity: 1; }
    100% { clip-path: polygon(0 0, 100% 0, 100% 0, 0 0); opacity: 0; }
  }

  .intro-bg-lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0.15;
  }

  .intro-bg-lines::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      repeating-linear-gradient(0deg, transparent, transparent 49px, rgba(124,92,252,0.5) 50px),
      repeating-linear-gradient(90deg, transparent, transparent 49px, rgba(124,92,252,0.5) 50px);
    background-size: 50px 50px;
    animation: grid-move 3s linear infinite;
  }

  @keyframes grid-move {
    from { transform: translateY(0); }
    to { transform: translateY(50px); }
  }

  .intro-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
  }
  .intro-orb1 { width: 600px; height: 600px; background: rgba(124,92,252,0.25); top: -200px; left: -200px; animation: intro-orb-drift 4s ease-in-out infinite alternate; }
  .intro-orb2 { width: 500px; height: 500px; background: rgba(0,212,170,0.18); bottom: -150px; right: -150px; animation: intro-orb-drift 4s 1s ease-in-out infinite alternate; }

  @keyframes intro-orb-drift {
    from { transform: translate(0,0); }
    to { transform: translate(30px, 20px); }
  }

  .intro-content {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .intro-logo {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c5cfc, #00d4aa);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    color: #fff;
    overflow: hidden;
    box-shadow: 0 0 40px rgba(124,92,252,0.7), 0 0 80px rgba(124,92,252,0.3);
    animation: intro-logo-in 0.6s cubic-bezier(0.34,1.56,0.64,1) both;
    position: relative;
  }

  .intro-logo img {
    width: 100%; height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .intro-logo::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #7c5cfc, #00d4aa, #c850c0, #7c5cfc);
    z-index: -1;
    animation: spin-slow 2s linear infinite;
  }

  @keyframes intro-logo-in {
    from { opacity: 0; transform: scale(0.3) rotate(-180deg); }
    to { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  .intro-name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    letter-spacing: -3px;
    line-height: 1;
    animation: intro-name-in 0.7s 0.3s cubic-bezier(0.34,1.2,0.64,1) both;
  }

  .intro-name span {
    background: var(--grad2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @keyframes intro-name-in {
    from { opacity: 0; transform: translateY(40px); filter: blur(8px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  .intro-tagline {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--teal);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    animation: intro-tag-in 0.7s 0.5s ease both;
  }

  @keyframes intro-tag-in {
    from { opacity: 0; letter-spacing: 0.5em; }
    to { opacity: 1; letter-spacing: 0.2em; }
  }

  .intro-loader {
    width: 200px;
    height: 2px;
    background: rgba(255,255,255,0.08);
    border-radius: 99px;
    overflow: hidden;
    margin-top: 1rem;
    animation: intro-loader-appear 0.5s 0.7s ease both;
  }

  @keyframes intro-loader-appear {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .intro-loader-fill {
    height: 100%;
    background: var(--grad);
    border-radius: 99px;
    width: 0%;
    animation: intro-load 1.8s 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    box-shadow: 0 0 12px rgba(124,92,252,0.8);
  }

  @keyframes intro-load {
    0% { width: 0%; }
    30% { width: 35%; }
    60% { width: 70%; }
    85% { width: 88%; }
    100% { width: 100%; }
  }

  .intro-pct {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text3);
    animation: intro-loader-appear 0.5s 0.7s ease both;
  }

  /* Scanline effect */
  #intro-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.08) 3px, rgba(0,0,0,0.08) 4px);
    pointer-events: none;
    z-index: 3;
  }

  /* ── CUSTOM CURSOR ── */
  .cursor {
    position: fixed;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--purple);
    pointer-events: none;
    z-index: 999999;
    transform: translate(-50%, -50%);
    transition: width 0.2s, height 0.2s, background 0.2s;
    mix-blend-mode: normal;
    box-shadow: 0 0 10px rgba(124,92,252,0.8);
    left: -100px; top: -100px;
  }
  .cursor-trail {
    position: fixed;
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1.5px solid rgba(124,92,252,0.6);
    pointer-events: none;
    z-index: 999998;
    transform: translate(-50%, -50%);
    transition: left 0.1s ease, top 0.1s ease, width 0.3s, height 0.3s;
    left: -100px; top: -100px;
  }
  body:has(a:hover) .cursor, body:has(button:hover) .cursor { width: 22px; height: 22px; background: var(--teal); box-shadow: 0 0 14px rgba(0,212,170,0.9); }
  body:has(a:hover) .cursor-trail, body:has(button:hover) .cursor-trail { width: 60px; height: 60px; border-color: rgba(0,212,170,0.5); }

  /* ── NOISE OVERLAY ── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: 0.6;
  }

  /* ── MESH BG ORBS ── */
  .orb {
    position: fixed;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
    animation: orb-float 12s ease-in-out infinite alternate;
  }
  .orb1 { width: 600px; height: 600px; background: rgba(124,92,252,0.14); top: -200px; left: -200px; animation-delay: 0s; }
  .orb2 { width: 500px; height: 500px; background: rgba(0,212,170,0.10); bottom: 100px; right: -150px; animation-delay: -4s; }
  .orb3 { width: 400px; height: 400px; background: rgba(200,80,192,0.09); top: 40%; left: 40%; animation-delay: -8s; }
  .orb4 { width: 350px; height: 350px; background: rgba(255,107,157,0.07); top: 60%; left: 10%; animation-delay: -6s; }

  @keyframes orb-float {
    from { transform: translate(0,0) scale(1); }
    to { transform: translate(30px, 20px) scale(1.08); }
  }

  /* ── FLOATING PARTICLES ── */
  .particles { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
  .particle {
    position: absolute;
    border-radius: 50%;
    animation: particle-float linear infinite;
    opacity: 0;
  }
  @keyframes particle-float {
    0% { transform: translateY(100vh) scale(0); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 0.6; }
    100% { transform: translateY(-100px) scale(1); opacity: 0; }
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 1.1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: rgba(6,6,16,0.75);
    border-bottom: 0.5px solid var(--border);
    transition: background 0.3s;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .nav-logo-img {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c5cfc, #00d4aa);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    color: #fff;
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 15px rgba(124,92,252,0.5), 0 0 30px rgba(124,92,252,0.2);
    animation: logo-glow 3s ease-in-out infinite alternate;
    flex-shrink: 0;
  }
  .nav-logo-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

  @keyframes logo-glow {
    from { box-shadow: 0 0 15px rgba(124,92,252,0.5), 0 0 30px rgba(124,92,252,0.2); }
    to { box-shadow: 0 0 25px rgba(0,212,170,0.6), 0 0 50px rgba(0,212,170,0.25); }
  }

  .nav-logo-text {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.5px;
  }

  .nav-links { display: flex; gap: 2rem; list-style: none; }

  .nav-links a {
    font-size: 13px;
    font-weight: 500;
    color: var(--text2);
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color 0.2s;
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px; left: 0;
    width: 0; height: 1px;
    background: var(--grad);
    transition: width 0.3s;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { width: 100%; }

  .nav-cta {
    font-size: 13px;
    font-weight: 500;
    padding: 0.5rem 1.2rem;
    border-radius: 99px;
    background: var(--grad);
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 0 20px rgba(124,92,252,0.35);
  }
  .nav-cta:hover { opacity: 0.88; transform: translateY(-1px); box-shadow: 0 0 30px rgba(124,92,252,0.55); }

  .nav-admin-btn {
    font-size: 11px;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: 99px;
    background: transparent;
    border: 0.5px solid rgba(0,212,170,0.3);
    color: var(--teal);
    text-decoration: none;
    transition: all 0.2s;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    cursor: none;
    margin-right: 0.5rem;
  }
  .nav-admin-btn:hover { background: rgba(0,212,170,0.1); border-color: var(--teal); }

  .hamburger { display: none; flex-direction: column; gap: 5px; cursor: none; }
  .hamburger span { width: 22px; height: 1.5px; background: var(--text); border-radius: 2px; transition: all 0.3s; }

  /* ── SECTION BASE ── */
  section { position: relative; z-index: 1; }
  .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }

  /* ── HERO ── */
  #hero { min-height: 100vh; display: flex; align-items: stretch; padding: 7rem 0 0; overflow: hidden; }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    align-items: end;
    gap: 2rem;
    width: 100%;
  }
  .hero-left { padding-bottom: 4rem; }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--teal);
    border: 0.5px solid rgba(0,212,170,0.3);
    padding: 0.4rem 0.9rem;
    border-radius: 99px;
    margin-bottom: 1.5rem;
    animation: fade-up 0.6s ease both;
    box-shadow: 0 0 20px rgba(0,212,170,0.1);
  }
  .hero-badge::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--teal); animation: pulse 2s infinite; box-shadow: 0 0 8px var(--teal); }

  @keyframes pulse { 0%,100%{opacity:1; transform:scale(1);} 50%{opacity:0.4; transform:scale(0.8);} }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -2px;
    margin-bottom: 0.5rem;
    animation: fade-up 0.6s 0.1s ease both;
  }
  .hero-name span { background: var(--grad2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    font-weight: 600;
    color: var(--text2);
    margin-bottom: 1.5rem;
    letter-spacing: -0.3px;
    animation: fade-up 0.6s 0.2s ease both;
  }

  .hero-desc {
    font-size: 17px;
    color: var(--text2);
    max-width: 520px;
    line-height: 1.75;
    margin-bottom: 2.5rem;
    animation: fade-up 0.6s 0.3s ease both;
  }
  .hero-desc strong { color: var(--text); font-weight: 500; }

  .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; animation: fade-up 0.6s 0.4s ease both; }

  .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 0.85rem 1.8rem; border-radius: 99px;
    background: var(--grad); color: #fff;
    font-family: var(--font-display); font-size: 14px; font-weight: 700;
    text-decoration: none; letter-spacing: 0.02em;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 0 30px rgba(124,92,252,0.4); cursor: none;
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 0 50px rgba(124,92,252,0.7); }

  .btn-secondary {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 0.85rem 1.8rem; border-radius: 99px;
    background: transparent; border: 0.5px solid var(--border2);
    color: var(--text); font-family: var(--font-display); font-size: 14px; font-weight: 600;
    text-decoration: none; transition: border-color 0.2s, background 0.2s, box-shadow 0.2s; cursor: none;
  }
  .btn-secondary:hover { border-color: var(--purple2); background: var(--surface); box-shadow: 0 0 20px rgba(124,92,252,0.15); }

  .hero-stats {
    display: flex; gap: 2rem; margin-top: 3rem;
    padding-top: 2rem; border-top: 0.5px solid var(--border);
    animation: fade-up 0.6s 0.5s ease both;
  }
  .stat-item { text-align: left; }
  .stat-num {
    font-family: var(--font-display); font-size: 2rem; font-weight: 800;
    background: var(--grad); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text; line-height: 1; filter: drop-shadow(0 0 8px rgba(124,92,252,0.4));
  }
  .stat-label { font-size: 12px; color: var(--text3); margin-top: 3px; font-weight: 400; }

  .hero-avatar-wrapper { width: 420px; flex-shrink: 0; animation: fade-up 0.6s 0.3s ease both; position: relative; align-self: stretch; display: flex; align-items: flex-end; }
  .hero-avatar-ring { position: relative; width: 100%; height: 100%; min-height: 520px; display: flex; align-items: flex-end; justify-content: center; overflow: hidden; }
  .hero-avatar-ring::before { display: none; }
  .hero-avatar-ring::after { display: none; }
  .hero-avatar-img { width: 100%; height: 100%; object-fit: cover; object-position: top center; border: none; border-radius: 0; position: relative; z-index: 1; filter: drop-shadow(0 20px 60px rgba(0,0,0,0.7)); animation: hero-float 4s ease-in-out infinite; -webkit-mask-image: linear-gradient(to bottom, black 70%, transparent 100%); mask-image: linear-gradient(to bottom, black 70%, transparent 100%); }
  @keyframes hero-float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-18px); } }
  .hero-img-badge { position: absolute; bottom: 60px; left: -10px; background: rgba(13,13,31,0.92); border: 0.5px solid var(--border2); border-radius: 14px; padding: 0.8rem 1.1rem; z-index: 10; backdrop-filter: blur(12px); display: flex; align-items: center; gap: 10px; box-shadow: 0 8px 32px rgba(0,0,0,0.4), 0 0 20px rgba(0,212,170,0.1); }
  .hero-img-badge-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 8px var(--teal); animation: pulse 2s infinite; flex-shrink: 0; }
  .hero-img-badge-text { font-family: var(--font-mono); font-size: 11px; color: var(--text2); line-height: 1.4; }
  .hero-img-badge-text strong { display: block; color: var(--text); font-size: 12px; }
  .hero-img-tag { position: absolute; top: 80px; right: 10px; background: var(--grad); border-radius: 10px; padding: 0.5rem 0.85rem; z-index: 10; font-family: var(--font-mono); font-size: 10px; font-weight: 600; color: #fff; letter-spacing: 0.08em; box-shadow: 0 4px 20px rgba(124,92,252,0.5); }
  .orbit-dot { display: none; }
  @keyframes spin-slow { to { transform: rotate(360deg); } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }

  /* Social Bar */
  .social-bar { display: flex; align-items: center; gap: 0.75rem; margin-top: 2rem; animation: fade-up 0.6s 0.6s ease both; }
  .social-bar-label { font-size: 11px; color: var(--text3); font-family: var(--font-mono); letter-spacing: 0.08em; }
  .social-link { width: 36px; height: 36px; border-radius: 10px; background: var(--surface); border: 0.5px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--text2); transition: all 0.2s; cursor: none; }
  .social-link svg { width: 15px; height: 15px; }
  .social-link:hover { background: var(--surface2); border-color: var(--border2); transform: translateY(-2px); }
  .sl-github:hover { color: #fff; }
  .sl-linkedin:hover { color: #0077b5; }
  .sl-twitter:hover { color: #1da1f2; }
  .sl-facebook:hover { color: #1877f2; }
  .sl-youtube:hover { color: #ff0000; }
  .sl-instagram:hover { color: #e4405f; }

  /* ── ABOUT ── */
  #about { padding: 7rem 0; }
  .section-tag { font-family: var(--font-mono); font-size: 12px; color: var(--teal); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.75rem; }
  .section-title { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -1.5px; line-height: 1.1; margin-bottom: 1.5rem; }
  .section-title span { background: var(--grad); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  .about-text p { color: var(--text2); margin-bottom: 1.2rem; font-size: 16px; line-height: 1.8; }
  .about-text p strong { color: var(--text); font-weight: 500; }
  .about-visual { position: relative; height: 460px; }
